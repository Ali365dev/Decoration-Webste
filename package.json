{
  "name": "dec-walls",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:store": "turbo run dev --filter=@dec-walls/storefront",
    "dev:ops": "turbo run dev --filter=@dec-walls/ops",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @dec-walls/db",
    "db:migrate": "npm run db:migrate -w @dec-walls/db",
    "db:studio": "npm run db:studio -w @dec-walls/db",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "turbo": "^2.5.8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
